# nginx del frontend. ${PUERTO} y ${API_UPSTREAM} se toman de las variables de entorno al arrancar el
# contenedor (en INSALUD: 5000 y http://10.10.0.7:3001): así el navegador ve la aplicación y la API bajo
# el mismo nombre y puerto, sin CORS.
server {
    listen ${PUERTO};
    server_name _;
    root /usr/share/nginx/html;

    # Excel de Master RRHH
    client_max_body_size 10m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Reportes en Excel pueden tardar unos segundos
        proxy_read_timeout 120s;
    }

    # Archivos con hash en el nombre: caché larga
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Aplicación: cualquier otra ruta devuelve index.html, sin caché para tomar siempre la última versión
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
